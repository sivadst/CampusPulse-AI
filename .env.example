# CampusPulse AI - SRM University-AP Edition Configuration Example
# Copy this file to .env and configure your variables

PORT=3001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Application Mode: demo | gmail
APP_MODE=demo

# AI Provider: gemini | mock
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# University Domain Filter (Comma-separated)
ALLOWED_UNIVERSITY_DOMAINS=srmap.edu.in

# Google OAuth Credentials (for Live Gmail Mode)
# Create credentials in Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/google/oauth/callback


# Google Maps API (Optional for enhanced live map rendering)
GOOGLE_MAPS_API_KEY=

# Security & Sessions
JWT_SECRET=super_secret_campuspulse_jwt_key_srmap_edition_2026
SESSION_SECRET=super_secret_session_key_srmap_edition_2026
